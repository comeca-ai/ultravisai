{
  // Ultravis Server como Container na edge — ver src/index.js e README.md
  // Requisitos: Workers Paid (Containers) e token do template "Edit Cloudflare
  // Workers" no secret (wrangler builda/publica a imagem; a API REST crua não
  // cobre containers).
  "name": "ultravis-server",
  "account_id": "749b2e9b3642e4b03321d5830e81c195",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "UltravisServer",
      // contexto de build = server/ (mesmo Dockerfile que o Railway usava)
      "image": "../../server/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SERVER", "class_name": "UltravisServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UltravisServer"] }],
  // keepalive: mantém o node-cron interno vivo (lift-and-shift v1)
  "triggers": { "crons": ["*/10 * * * *"] }
}
