NODE_ENV=development
PORT=80

# Logging
# Set log level: debug, info, warn, error. Defaults to debug in development, info in production.
LOG_LEVEL=debug

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEFAULT_SUGGESTION_MODEL=google/gemini-3-flash-preview
TOPIC_SUGGESTION_MODEL=google/gemini-3-flash-preview
PROMPT_SUGGESTION_MODEL=google/gemini-3-flash-preview
COMPETITOR_SUGGESTION_MODEL=google/gemini-3-flash-preview
# Model used for the Site Audit LLM-judged signals (provider/model). Cheap by
# default; point it at anthropic/claude-... or openai/... if you prefer.
AUDIT_LLM_MODEL=google/gemini-3-flash-preview
# Vigia de consistência — camada 2 (agente LLM semanal, pós-censo): modelo da
# rodada (provider/model). Sem esta env, cai no AUDIT_LLM_MODEL; sem NENHUMA
# das duas o agente fica desligado (só loga). Ver lib/consistency-llm.js.
# CONSISTENCY_LLM_MODEL=anthropic/claude-sonnet-4-20250514

# Site Audit page fetching (proxy + JS render)
SCRAPEDO_API_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Cloud / Self-hosted mode
# Set to "true" only for the official cloud deployment.
# Self-hosted instances should leave this unset or "false" — all features
# will be unlocked automatically.
IS_CLOUD=false

# DataForSEO (for keyword volume data)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Cloro (platform web scrapers)
CLORO_API_KEY=

# Cloro webhook callback URL (publicly reachable, e.g. https://api.example.com/cloro/callback).
# When set, tracking jobs submit tasks with this webhook and DO NOT poll inline —
# Cloro pushes results to /cloro/callback as they complete (survives server restarts
# and scales without blocking workers). Leave empty to fall back to inline polling.
CLORO_WEBHOOK_URL=

# Cloro webhook signing secret (whsec_…). Generated when you enable signed
# deliveries at https://dashboard.cloro.dev/webhooks — shown exactly once, store
# it here. When set, /cloro/callback rejects any delivery without a valid
# HMAC signature (401) or with a stale timestamp (400). Leave empty to accept
# unsigned deliveries (the default; required while dashboard signing is off).
# IMPORTANT: flip the dashboard switch and set this value together — setting
# only one of the two breaks webhook delivery.
CLORO_WEBHOOK_SECRET=

# ── Drain tuning (sync seletivo do upstream #649/#690/#710/#716) ──
# Consecutive quiet 15s polls before the drain gives up on a stalled delivery
# (default 100 ≈ 25 min — Cloro delivers in bursts with 10+ min silences).
CLORO_STALL_POLL_LIMIT=
# Quiet polls before exiting when every remaining task is a ghost (default 60).
CLORO_GHOST_STALL_POLLS=
# Age (minutes) after which a still-pending task counts as a ghost — accepted
# by Cloro but never called back, e.g. google-aio with no AI Overview
# (default 30; raise it if healthy runs start exiting as 'ghosts').
CLORO_GHOST_TASK_AGE_MIN=
# How long (minutes) to wait for the FIRST result before giving up entirely
# (default 90 — slow queue starts of 60+ min happen on large runs).
CLORO_FIRST_RESULT_WAIT_MIN=
# Tail budget (minutes) measured from the first delivered result (default 60).
CLORO_DRAIN_TAIL_MIN=
# Max tracking jobs processed at once (default 2).
TRACKING_CONCURRENCY=

# Platform provider for web scrapers (default: cloro)
PLATFORM_PROVIDER=cloro

# AI Volume Multiplier (AI search adoption rate, e.g. 0.15 = 15%)
AI_VOLUME_MULTIPLIER=0.15

# Cron / Internal-endpoint secret (cloud only — not needed for self-hosted)
# Guards three internal server endpoints:
#   /api/internal/daily-tracking
#   /api/internal/content/:id/brief
#   /api/internal/trigger-tracking
# The web app sends this as "Authorization: Bearer <value>"; the server
# compares against its own copy. MUST be the same value on both sides.
# Generate: openssl rand -hex 32
# CRON_SECRET=

# Stripe (cloud only — not needed for self-hosted)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...


# -----------------------------------------------------------------------------
# Watchdog (active monitoring — Ultravis addition)
# -----------------------------------------------------------------------------
# Where alerts are POSTed as JSON (n8n webhook, Slack incoming webhook, etc.).
# Unset = alerts are only logged.
ALERT_WEBHOOK_URL=
# Check cadence in minutes (default 15, min 5).
WATCHDOG_INTERVAL_MIN=15

# One-shot: recompute mentions/sentiment for a brand's stored results
# (set to a brand uuid, deploy, wait for "[backfill-mentions] DONE", unset).
BACKFILL_MENTIONS_BRAND_ID=

# ── Daily Pulse (Funil pacote 2, sync do upstream #540/#654/#701) ──
# E-mail do pulse: Resend (preferido) OU as mesmas credenciais SMTP do
# watchdog (SMTP_USER/SMTP_PASS acima). Sem nenhum dos dois, o pulse ainda
# roda e dispara o webhook `daily_pulse.created`; só o e-mail é pulado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Base dos links no e-mail/webhook do pulse (ex.: https://ultravis.ai)
PUBLIC_APP_URL=

# Watchdog: vigia de drift de deploy do web (incidente 17/ago — Vercel serviu
# build de 9 dias sem ninguém notar). Opcional; sem as vars o check é pulado.
# Criar o token direto no painel da Vercel (Account Settings → Tokens).
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=prj_iBxx4P98kVLH1FQv6uez7a8lar5g
# VERCEL_TEAM_ID=team_1AWGipOQAj52oSNl26X1Qwum

# Checagem direta de plataformas de review (D4 do IC) — semanal + boot.
# REVIEW_CHECK_CRON=30 8 * * 1

# Varredura multi-página do site (D1 do IC) — mensal por padrão (custo de
# proxy: ~10 páginas com render por marca). Warm-up no boot quando vazio.
# SITE_CRAWL_CRON=0 9 1 * *

# Retry residencial do Reclame Aqui (~25 créditos Scrape.do por requisição —
# esgotou o plano em 18/ago; ligue só com saldo folgado ou plano maior).
# REVIEW_CHECK_RESIDENTIAL=true

# Enriquecimento de posição por ordem de aparição (Posição do Score) —
# só SQL/regex, custo zero. Default: a cada 30 min + warm-up no boot.
# APPEARANCE_RANK_CRON=*/30 * * * *

# Vigia de consistência camada 2 — agenda da rodada semanal do agente LLM
# (1 chamada por rodada). Default: segunda 09:00 UTC, ~3h depois do censo
# semanal de segunda 06:00 UTC (DAILY_CRON_SCHEDULE).
# CONSISTENCY_LLM_CRON=0 9 * * 1

# Cloudflare AI Gateway (opcional — quando setado, TODA chamada de LLM passa
# pelo gateway "ultravis": log, custo, cache e retry no painel do Cloudflare).
# Apagar AI_GATEWAY_ACCOUNT_ID volta tudo pro endpoint direto.
AI_GATEWAY_ACCOUNT_ID=
AI_GATEWAY_NAME=ultravis
# Só com "Authenticated Gateway" ligado (permite guardar as chaves no gateway):
AI_GATEWAY_TOKEN=
