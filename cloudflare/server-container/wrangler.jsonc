{
  // Ultravis Server como Container na edge — ver src/index.js e README.md
  // Requisitos: Workers Paid (Containers) e token do template "Edit Cloudflare
  // Workers" no secret (wrangler builda/publica a imagem; a API REST crua não
  // cobre containers).
  "name": "ultravis-server",
  "account_id": "749b2e9b3642e4b03321d5830e81c195",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  // CRÍTICO: sem isto, cada `wrangler deploy` APAGA as variáveis de texto
  // coladas no painel — foi a causa-raiz dos runs #3–#9 (worker sem env,
  // container em crash-loop por "Missing SUPABASE_URL").
  "keep_vars": true,
  // Config NÃO-secreta do server (a secreta vive no painel como Secret).
  // Sem isto: CORS só aceita localhost:3000, o censo roda TODO DIA às 06:00
  // (default do código; Railway limitava pra segunda) e o Cloro cai pro modo
  // polling em vez de webhook.
  "vars": {
    "NODE_ENV": "production",
    "ALLOWED_ORIGINS": "https://ultravis.ai,https://www.ultravis.ai,https://utravisaiclaude.vercel.app,http://localhost:3000",
    "DAILY_CRON_SCHEDULE": "0 6 * * 1",
    "CLORO_WEBHOOK_URL": "https://api.ultravis.ai/cloro/callback",
    "PUBLIC_APP_URL": "https://ultravis.ai"
  },
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "UltravisServer",
      // contexto de build = server/ (mesmo Dockerfile que o Railway usava)
      "image": "../../server/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SERVER", "class_name": "UltravisServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UltravisServer"] }],
  // keepalive: mantém o node-cron interno vivo (lift-and-shift v1)
  "triggers": { "crons": ["*/10 * * * *"] }
}
