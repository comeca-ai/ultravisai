# =============================================================================
# POC <nome> — web/.env.local
# Subconjunto do web/.env.example do repo.
# NUNCA commitar valores reais — este arquivo versiona só a estrutura.
# =============================================================================

# --- Modo POC: self-hosted = sem billing, sem limites -------------------------
NEXT_PUBLIC_IS_CLOUD=false

# --- Supabase (MESMO projeto do server desta POC) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- URLs desta POC -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:80

# --- Agente in-product (opcional; self-host usa a chave direto) ---------------
# ANTHROPIC_API_KEY=

# --- Analytics (off por default; ligar só se a POC precisar medir uso) --------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
