# =============================================================================
# POC <nome> — server/.env
# Subconjunto do server/.env.example do repo, organizado por nível de POC.
# NUNCA commitar valores reais — este arquivo versiona só a estrutura.
# =============================================================================

NODE_ENV=production
PORT=80
LOG_LEVEL=info

# --- Modo POC: self-hosted = sem billing, sem limites -------------------------
IS_CLOUD=false

# --- Supabase (projeto NOVO desta POC, ex. poc-<nome>) ------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS (domínios do web desta POC) -----------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# --- Cron do tracking (semanal por default em POC; diário = '0 6 * * *') ------
DAILY_CRON_SCHEDULE=0 6 * * 1

# =============================================================================
# NÍVEL 1 — tracking via API (1 chave basta; Gemini é o default das sugestões)
# =============================================================================
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Modelos por função (formato provider/modelo)
DEFAULT_SUGGESTION_MODEL=google/gemini-3-flash-preview
TOPIC_SUGGESTION_MODEL=google/gemini-3-flash-preview
PROMPT_SUGGESTION_MODEL=google/gemini-3-flash-preview
COMPETITOR_SUGGESTION_MODEL=google/gemini-3-flash-preview
AUDIT_LLM_MODEL=google/gemini-3-flash-preview

# =============================================================================
# NÍVEL 2 — superfícies reais via Cloro (descomentar quando subir de nível)
# =============================================================================
# PLATFORM_PROVIDER=cloro
# CLORO_API_KEY=
# CLORO_WEBHOOK_URL=https://api-poc-<nome>.exemplo.com/cloro/callback
# CLORO_WEBHOOK_SECRET=

# =============================================================================
# NÍVEL 3 — volumes + site audit (descomentar quando subir de nível)
# =============================================================================
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# SCRAPEDO_API_KEY=
# AI_VOLUME_MULTIPLIER=0.15

# --- Stripe: NÃO usar em POC (só cloud). Placeholder se algo exigir a var. ----
# STRIPE_SECRET_KEY=sk_test_placeholder_unused
